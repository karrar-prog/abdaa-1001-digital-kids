{
  "rewrites": [
    { "source": "/volunteer", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/scanner", "destination": "/index.html" },
    { "source": "/batch2", "destination": "/index.html" },
    { "source": "/agenda", "destination": "/index.html" },
    { "source": "/frame", "destination": "/index.html" },
    { "source": "/photobooth", "destination": "/index.html" },
    { "source": "/invite", "destination": "/index.html" },
    { "source": "/invitations", "destination": "/index.html" },
    { "source": "/campaign", "destination": "/index.html" },
    { "source": "/social", "destination": "/index.html" },
    { "source": "/posts", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' blob: data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-ancestors 'self'; base-uri 'self'; form-action 'self';"
        }
      ]
    }
  ]
}
